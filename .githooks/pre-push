#!/usr/bin/env bash
# Local pre-push checks. Wire up once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] cargo fmt --check"
cargo fmt --all -- --check

echo "[pre-push] cargo clippy"
cargo clippy --workspace --all-targets --quiet -- -D warnings

echo "[pre-push] cargo test --workspace"
cargo test --workspace --quiet

SHIM_DIR="npm/cross-env-rs/test"
if [ -d "$SHIM_DIR" ]; then
    SHIM_TESTS=$(find "$SHIM_DIR" -name '*.test.js' -type f)
    if [ -n "$SHIM_TESTS" ]; then
        echo "[pre-push] node --test (shim)"
        # shellcheck disable=SC2086
        node --test $SHIM_TESTS
    fi
fi

echo "[pre-push] ok"
